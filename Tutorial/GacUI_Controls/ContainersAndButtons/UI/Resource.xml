<?xml version="1.0" encoding="utf-8"?>
<Resource>
  <Folder name="GacGenConfig">
    <Folder name="Cpp">
      <Text name="SourceFolder">Source</Text>
      <Text name="Resource">..\..\UIRes\ContainersAndButtons.bin</Text>
      <Text name="NormalInclude">GacUI.h</Text>
      <Text name="Name">Demo</Text>
    </Folder>
  </Folder>
  <Folder name="MainWindow">
    <Instance name="MainWindowResource">
      <Instance ref.CodeBehind="false" ref.Class="demo::MainWindow" xmlns:x="presentation::controls::GuiSelectableButton::*">
        <Window Text="ContainersAndButtons" ClientSize="x:480 y:320">
          <att.ContainerComposition-set PreferredMinSize="x:480 y:320"/>
          <x:MutexGroupController ref.Name="radioGroup"/>

          <Tab>
            <att.BoundsComposition-set AlignmentToParent="left:3 top:3 right:3 bottom:3"/>

            <att.Pages>
              <TabPage Text="GroupBox">
                <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
                  <ez:Layout>
                    <ez:Fill>
                      <Bounds MinSizeLimitation="LimitToElementAndChildren">
                        <GroupBox Text="Button">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>

                          <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5">
                            <ez:Layout Border="false">
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <Button Text="Button 1">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </Button>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <Button Text="Button 2">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </Button>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <Button Text="Button 3">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </Button>
                                </Bounds>
                              </ez:Top>
                            </ez:Layout>
                          </Bounds>
                        </GroupBox>
                      </Bounds>
                    </ez:Fill>
                    <ez:Fill>
                      <Bounds MinSizeLimitation="LimitToElementAndChildren">
                        <GroupBox Text="CheckBox">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>

                          <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5">
                            <ez:Layout Border="false">
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <CheckBox Text="Button 1">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </CheckBox>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <CheckBox Text="Button 2">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </CheckBox>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <CheckBox Text="Button 3">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </CheckBox>
                                </Bounds>
                              </ez:Top>
                            </ez:Layout>
                          </Bounds>
                        </GroupBox>
                      </Bounds>
                    </ez:Fill>
                    <ez:Fill>
                      <Bounds MinSizeLimitation="LimitToElementAndChildren">
                        <GroupBox Text="RadioButton">
                          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>

                          <Bounds AlignmentToParent="left:5 top:5 right:5 bottom:5">
                            <ez:Layout Border="false">
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <RadioButton Text="Button 1" GroupController-ref="radioGroup" Selected="true">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </RadioButton>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <RadioButton Text="Button 2" GroupController-ref="radioGroup">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </RadioButton>
                                </Bounds>
                              </ez:Top>
                              <ez:Top>
                                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                                  <RadioButton Text="Button 3" GroupController-ref="radioGroup">
                                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                                  </RadioButton>
                                </Bounds>
                              </ez:Top>
                            </ez:Layout>
                          </Bounds>
                        </GroupBox>
                      </Bounds>
                    </ez:Fill>
                  </ez:Layout>
                </Bounds>
              </TabPage>

              <TabPage Text="ScrollContainer">
                <ScrollContainer HorizontalAlwaysVisible="false" VerticalAlwaysVisible="false">
                  <att.BoundsComposition-set AlignmentToParent="left:5 top:5 right:5 bottom:5"/>

                  <Bounds MinSizeLimitation="LimitToElementAndChildren">
                    <ez:Layout Padding="10">
                      <ez:Row>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(0, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(0, 1)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(0, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                      </ez:Row>
                      <ez:Row>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(1, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(1, 1)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(1, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                      </ez:Row>
                      <ez:Row>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(2, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(2, 1)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Button Text="(2, 0)">
                              <att.BoundsComposition-set PreferredMinSize="x:160 y:160"/>
                            </Button>
                          </Bounds>
                        </ez:Column>
                      </ez:Row>
                    </ez:Layout>
                  </Bounds>
                </ScrollContainer>
              </TabPage>

            </att.Pages>
          </Tab>
        </Window>
      </Instance>
    </Instance>
  </Folder>
</Resource>