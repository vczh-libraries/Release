<Folder>
  <Instance name="HyperlinkWindowResource">
    <Instance ref.CodeBehind="false" ref.Class="demo::HyperlinkWindow">
      <ref.Members>
        <![CDATA[
          prop Url : string? = null {}
        ]]>
      </ref.Members>
      <Window ref.Name="self" Text="Hyperlink" ClientSize="x:320 y:80" SizeBox="false" MinimizedBox="false" MaximizedBox="false" ShowInTaskBar="false">
        <att.BoundsComposition-set PreferredMinSize="x:320 y:80"/>
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
          <ez:Layout>
            <ez:Row>
              <ez:Column>
                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                  <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                    <ez:Layout Padding="0">
                      <ez:Row CellOption="composeType:Percentage percentage:0.5">
                        <ez:Column CellOption="composeType:Percentage percentage:1.0"/>
                      </ez:Row>
                      <ez:Row>
                        <ez:Column>
                          <Bounds MinSizeLimitation="LimitToElementAndChildren">
                            <Label Text="Url: "/>
                          </Bounds>
                        </ez:Column>
                      </ez:Row>
                      <ez:Row CellOption="composeType:Percentage percentage:0.5">
                        <ez:Column/>
                      </ez:Row>
                    </ez:Layout>
                  </Bounds>
                </Bounds>
              </ez:Column>
              <ez:Column CellSpan="3">
                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                  <SinglelineTextBox ref.Name="textUrl">
                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
                  </SinglelineTextBox>
                </Bounds>
              </ez:Column>
            </ez:Row>
            <ez:Row CellOption="composeType:Percentage percentage:1.0">
              <ez:Column/>
              <ez:Column CellOption="composeType:Percentage percentage:1.0"/>
              <ez:Column/>
              <ez:Column/>
            </ez:Row>
            <ez:Row>
              <ez:Column/>
              <ez:Column/>
              <ez:Column>
                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                  <Button Text="OK">
                    <att.BoundsComposition-set PreferredMinSize="x:100"/>
                    <ev.Clicked-eval>
                      <![CDATA[
                        {
                          self.Url = textUrl.Text;
                          self.Close();
                        }
                      ]]>
                    </ev.Clicked-eval>
                  </Button>
                </Bounds>
              </ez:Column>
              <ez:Column>
                <Bounds MinSizeLimitation="LimitToElementAndChildren">
                  <Button Text="Cancel">
                    <att.BoundsComposition-set PreferredMinSize="x:100"/>
                    <ev.Clicked-eval>
                      <![CDATA[
                        {
                          self.Url = null;
                          self.Close();
                        }
                      ]]>
                    </ev.Clicked-eval>
                  </Button>
                </Bounds>
              </ez:Column>
            </ez:Row>
          </ez:Layout>
        </Bounds>
      </Window>
    </Instance>
  </Instance>
</Folder>